# --- Primary: local Ollama ---
OLLAMA_BASE_URL=http://localhost:xxxx
OLLAMA_MODEL=qwen2.5:3b          # or your preferred model
OLLAMA_TIMEOUT_SECONDS=30

# --- Fallback: Claude API ---
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL= your-model-here
CLAUDE_TIMEOUT_SECONDS= your-timeout-seconds

# --- Fallback behaviour ---
PRIMARY_PROVIDER=your primary provider
FALLBACK_PROVIDER= your fallback provider
MAX_RETRIES_PER_PROVIDER=1
USAGE_LOG_PATH=your-log-path
